PORT=3001
DATABASE_URL=postgresql://postgres:password@localhost:5432/mission_zero
# Comma-separated exact frontend origins. Example: http://localhost:5173
CLIENT_ORIGIN=http://localhost:5173
# Set true only when running behind a trusted reverse proxy.
TRUST_PROXY=false
# Optional: enables server-evaluated mission attempts in the frontend.
VITE_API_BASE_URL=http://localhost:3001
